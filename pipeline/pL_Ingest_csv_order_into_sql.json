								},
								"sink": {
									"name": "Order_Date"
								}
							}
						],
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "dS_source_file_input",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "dS_blob_bronze",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "Copy_order_bronze_SQL_Order_table",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Script1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobStorageReadSettings",
							"recursive": true,
							"wildcardFileName": {
								"value": "@activity('brows_broze_blob_order').output.childItems[0].name",
								"type": "Expression"
							},
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "AzureSqlSink",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"name": "Order_ID"
								},
								"sink": {
									"name": "order_id",
									"type": "int",
									"precision": 10
								}
							},
							{
								"source": {
									"name": "Customer"
								},
								"sink": {
									"name": "customer",
									"type": "nvarchar"
								}
							},
							{
								"source": {
									"name": "Amount"
								},
								"sink": {
									"name": "amount",
									"type": "decimal",
									"scale": 2,
									"precision": 10
								}
							},
							{
								"source": {
									"name": "Order_Date"
								},
								"sink": {
									"name": "order_date",
									"type": "date"
								}
							}
						],
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "dS_blob_bronze",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "dS_sql_order",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "brows_broze_blob_order",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "Copy_order_file_bronze",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "dS_blob_bronze",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems",
						"itemName",
						"itemType"
					],
					"storeSettings": {
						"type": "AzureBlobStorageReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "Script1",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "brows_broze_blob_order",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "AzureSqlDatabase",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "NonQuery",
							"text": "IF EXISTS (SELECT 1 FROM Orders)\nBEGIN\n    DELETE FROM Orders;\n    PRINT 'Orders table data has been cleared.';\nEND\nELSE\nBEGIN\n    PRINT 'No data found in Orders table.';\nEND"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			}
		],
		"annotations": []
	}
}