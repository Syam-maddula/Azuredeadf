{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "myDataFactory1981234"
		},
		"AzureBlobStorage_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureBlobStorage'"
		},
		"AzureFileStorage_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'AzureFileStorage'"
		},
		"AzureSqlDatabase_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSqlDatabase'"
		},
		"AzureSqlDatabase_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "mysqlserver1981234.database.windows.net"
		},
		"AzureSqlDatabase_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "myDatabase1981234"
		},
		"AzureSqlDatabase_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sysadmin"
		},
		"sqlMPE_properties_privateLinkResourceId": {
			"type": "string",
			"defaultValue": "/subscriptions/9734ed68-621d-47ed-babd-269110dbacb1/resourceGroups/1-f77c8268-playground-sandbox/providers/Microsoft.Sql/servers/mySqlServer1981234"
		},
		"sqlMPE_properties_groupId": {
			"type": "string",
			"defaultValue": "sqlServer"
		},
		"storageMPE_properties_privateLinkResourceId": {
			"type": "string",
			"defaultValue": "/subscriptions/9734ed68-621d-47ed-babd-269110dbacb1/resourceGroups/1-f77c8268-playground-sandbox/providers/Microsoft.Storage/storageAccounts/mystorageacct1981234"
		},
		"storageMPE_properties_groupId": {
			"type": "string",
			"defaultValue": "blob"
		},
		"storageMPE_properties_fqdns": {
			"type": "array",
			"defaultValue": [
				"mystorageacct1981234.blob.core.windows.net"
			]
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "myDataFactory1981234_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureBlobStorage_connectionString": {
						"value": "[parameters('AzureBlobStorage_connectionString')]"
					},
					"AzureFileStorage_connectionString": {
						"value": "[parameters('AzureFileStorage_connectionString')]"
					},
					"AzureSqlDatabase_password": {
						"value": "[parameters('AzureSqlDatabase_password')]"
					},
					"AzureSqlDatabase_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDatabase_properties_typeProperties_server')]"
					},
					"AzureSqlDatabase_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDatabase_properties_typeProperties_database')]"
					},
					"AzureSqlDatabase_properties_typeProperties_userName": {
						"value": "[parameters('AzureSqlDatabase_properties_typeProperties_userName')]"
					},
					"sqlMPE_properties_privateLinkResourceId": {
						"value": "[parameters('sqlMPE_properties_privateLinkResourceId')]"
					},
					"sqlMPE_properties_groupId": {
						"value": "[parameters('sqlMPE_properties_groupId')]"
					},
					"storageMPE_properties_privateLinkResourceId": {
						"value": "[parameters('storageMPE_properties_privateLinkResourceId')]"
					},
					"storageMPE_properties_groupId": {
						"value": "[parameters('storageMPE_properties_groupId')]"
					},
					"storageMPE_properties_fqdns": {
						"value": "[parameters('storageMPE_properties_fqdns')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}